{
  "schemaVersion": 1,
  "id": "lss",
  "version": "${version}",
  "name": "LOD Server Support",
  "description": "Fabric client/server Mod that provides unofficial multiplayer support for Voxy.",
  "authors": [
    "VoX"
  ],
  "contact": {
    "sources": "https://github.com/VoX/lod-server-support"
  },
  "license": "MIT",
  "icon": "assets/lss/icon.png",
  "accessWidener": "lss.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.vox.lss.LSSMod"
    ],
    "client": [
      "dev.vox.lss.LSSClient"
    ],
    "sodium:config_api_user": [
      "dev.vox.lss.config.LSSConfigMenu"
    ],
    "modmenu": [
      "dev.vox.lss.config.LSSModMenuIntegration"
    ]
  },
  "mixins": [
    "lss.mixins.json",
    "lss-trace.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/sqlite-jdbc-slim.jar"
    },
    {
      "file": "META-INF/jars/zstd-jni-slim.jar"
    }
  ],
  "depends": {
    "minecraft": ">=26.1 <26.2-",
    "fabricloader": ">=0.18.4",
    "fabric-api": ">=0.146.0"
  },
  "suggests": {
    "sodium": ">=0.8.12",
    "modmenu": "*",
    "voxy": ">=0.2.17-alpha"
  }
}
